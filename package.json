{
  "name": "reqtest-http",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint",
    "check:english": "node scripts/check-english.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "example": "node tests/api-fixture.mjs",
    "sandbox:build": "docker build -t reqtest-python:1 sandbox",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:decisions": "tsx scripts/evaluate-decisions.ts",
    "score": "tsx scripts/score.ts",
    "example:zip": "node scripts/example.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "tsx scripts/database.ts",
    "db:migrate:production": "NODE_ENV=production tsx scripts/database.ts",
    "db:import-sqlite": "node --import tsx scripts/import-sqlite.mjs",
    "mail:up": "docker compose --profile mail up -d mail",
    "verify": "tsx scripts/verify.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:production": "NODE_ENV=production tsx scripts/worker.ts",
    "dev:all": "concurrently --kill-others --names web,worker \"npm run dev\" \"npm run worker\"",
    "start:all": "concurrently --kill-others --names web,worker \"npm run start\" \"npm run worker:production\"",
    "production:check": "tsx scripts/production.ts check",
    "production:start": "tsx scripts/production.ts start",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:verify": "tsx scripts/backup.ts verify",
    "backup:restore": "tsx scripts/backup.ts restore",
    "test:queue": "REQTEST_DOCKER_TEST=1 node --import tsx --test tests/run-queue.test.ts",
    "test:runtime": "REQTEST_DOCKER_TEST=1 node --import tsx --test tests/runtime.test.ts",
    "experiment:run": "tsx scripts/evaluate.ts examples/experiments.json",
    "experiment:analyze": "tsx scripts/analyze-experiment.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@next/env": "16.4.3",
    "ai": "^7.0.137",
    "better-auth": "^1.7.11",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "eventsource-parser": "3.1.1",
    "idb-keyval": "6.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.54.0",
    "minisearch": "^7.2.0",
    "next": "16.4.3",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
