REQTEST_DATABASE_PATH=data/reqtest.db
REQTEST_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Every value below is optional, and a blank value means "not configured" rather than
# a default. Copying this file without editing it leaves the app in scaffold mode.

# Use true when serving over HTTPS. False is only for local HTTP development.
REQTEST_SESSION_COOKIE_SECURE=false
# Sessions expire after seven days and are revoked on sign-out.
REQTEST_SESSION_TTL_SECONDS=604800

# Model credentials for the agent stages. Without a key the app starts in scaffold
# mode: projects and runs are still recorded, but nothing is analysed or generated.
# Keep the real key in .env, which is git-ignored.
ANTHROPIC_API_KEY=

# Optional agent settings.
REQTEST_LLM_ENABLED=true
REQTEST_LLM_MODEL=claude-opus-5
REQTEST_LLM_MAX_TOKENS=16000
REQTEST_LLM_TIMEOUT_SECONDS=180
REQTEST_MAX_REQUIREMENTS=40
REQTEST_MAX_SCENARIOS=80
# Maximum queued and running jobs combined; one local worker executes them serially.
REQTEST_MAX_ACTIVE_RUNS=20

# GitHub repositories. A project's "repository reference" may be a GitHub URL such as
# https://github.com/owner/repository, optionally ending in /tree/<branch>/<folder>
# or /commit/<sha>. Each run downloads that code at a pinned commit through the GitHub
# API; this needs no repository root. Other hosts and URLs with credentials are refused.
REQTEST_GITHUB_ENABLED=true
# Optional. Reads private repositories and raises the 60 requests/hour anonymous
# limit. Use a fine-grained token with read-only Contents access. It is shared
# server configuration: every account can read what this token can read.
REQTEST_GITHUB_TOKEN=
REQTEST_GITHUB_TIMEOUT_SECONDS=60
REQTEST_GITHUB_MAX_ARCHIVE_BYTES=50000000

# Local repository inspection. This is the BOUNDARY, not the repository to test.
#
# Which repository a run tests comes from that project's "repository reference"
# field in the UI. For a local path, this setting is the directory those
# references must resolve inside; anything outside it is refused.
#
#   REQTEST_REPOSITORY_ROOT=/Users/you/repos
#     repository reference "shipping" -> /Users/you/repos/shipping
#     repository reference "../etc"   -> refused
#
# With a single project, point this at the repository itself and use "." as the
# reference. Keep it as narrow as possible: a reference of "." reads every
# repository inside the root, and only the public interface of each module is
# read, but there is no reason to widen the boundary further than you need.
#
# Unset means a saved local path is stored but never read.
REQTEST_REPOSITORY_ROOT=
REQTEST_MAX_INSPECTED_FILES=60

# Sandbox for executing generated tests. Requires Docker and the image built by
# scripts/build-sandbox.sh. With either missing, tests are generated but not executed.
REQTEST_SANDBOX_ENABLED=true
REQTEST_SANDBOX_IMAGE=reqtest-sandbox:1
REQTEST_SANDBOX_TIMEOUT_SECONDS=120
REQTEST_SANDBOX_MEMORY=512m
REQTEST_SANDBOX_CPUS=1

# Saved code snapshots. Blank uses the database directory/repository-snapshots.
# Copies are retained for provenance; limits apply to each copy, not total storage.
REQTEST_REPOSITORY_SNAPSHOT_ROOT=
# Includes files and directories. Exceeding either limit refuses a partial copy.
REQTEST_MAX_SNAPSHOT_FILES=2000
REQTEST_MAX_SNAPSHOT_BYTES=20000000

# Local document OCR and legacy Word conversion.
# Run scripts/setup-document-tools.sh; macOS uses its built-in textutil for .doc.
REQTEST_DOCUMENT_OCR_ENABLED=true
REQTEST_DOCUMENT_OCR_LANGUAGES=eng
REQTEST_DOCUMENT_TESSERACT_BINARY=tesseract
# Linux: soffice must be installed. macOS uses /usr/bin/textutil automatically.
REQTEST_DOCUMENT_CONVERTER_BINARY=soffice
REQTEST_DOCUMENT_OCR_MAX_PAGES=20
REQTEST_DOCUMENT_IMPORT_TIMEOUT_SECONDS=120
