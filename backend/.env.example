REQTEST_DATABASE_PATH=data/reqtest.db
REQTEST_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Every value below is optional, and a blank value means "not configured" rather than
# a default. Copying this file without editing it leaves the app in scaffold mode.

# Use true when serving over HTTPS. False is only for local HTTP development.
REQTEST_SESSION_COOKIE_SECURE=false
# Sessions expire after seven days and are revoked on sign-out.
REQTEST_SESSION_TTL_SECONDS=604800

# Model credentials for the agent stages. Without a key the app starts in scaffold
# mode: projects and runs are still recorded, but nothing is analysed or generated.
# Keep the real key in .env, which is git-ignored.
ANTHROPIC_API_KEY=

# Optional agent settings.
REQTEST_LLM_ENABLED=true
REQTEST_LLM_MODEL=claude-opus-5
REQTEST_LLM_MAX_TOKENS=16000
REQTEST_LLM_TIMEOUT_SECONDS=180
REQTEST_MAX_REQUIREMENTS=40

# Repository inspection. This is the BOUNDARY, not the repository to test.
#
# Which repository a run tests comes from that project's "repository reference"
# field in the UI. This setting is the directory those references must resolve
# inside; anything outside it, and any remote URL, is refused.
#
#   REQTEST_REPOSITORY_ROOT=/Users/you/repos
#     repository reference "shipping" -> /Users/you/repos/shipping
#     repository reference "../etc"   -> refused
#
# With a single project, point this at the repository itself and use "." as the
# reference. Keep it as narrow as possible: a reference of "." reads every
# repository inside the root, and only the public interface of each module is
# read, but there is no reason to widen the boundary further than you need.
#
# Unset means the saved repository reference is stored but never read.
REQTEST_REPOSITORY_ROOT=
REQTEST_MAX_INSPECTED_FILES=60

# Sandbox for executing generated tests. Requires Docker and the image built by
# scripts/build-sandbox.sh. With either missing, tests are generated but not executed.
REQTEST_SANDBOX_ENABLED=true
REQTEST_SANDBOX_IMAGE=reqtest-sandbox:1
REQTEST_SANDBOX_TIMEOUT_SECONDS=120
REQTEST_SANDBOX_MEMORY=512m
REQTEST_SANDBOX_CPUS=1
