DATABASE_URL=postgresql://reqtest:reqtest@127.0.0.1:5433/reqtest
OPENAI_API_KEY=
REQTEST_LLM_MODEL=gpt-6-luna
BETTER_AUTH_URL=http://127.0.0.1:3001
# Optional: persist a strong signing secret for a deployment (minimum 32 random characters).
BETTER_AUTH_SECRET=
# Optional: GitHub OAuth App credentials. Register the callback URL shown in Account.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# REQTEST_SANDBOX_IMAGE=reqtest-python:1
# REQTEST_DATA_NAMESPACE=
# Local development mailbox; run npm run mail:up and visit http://127.0.0.1:8025.
REQTEST_LOCAL_MAIL=false
# For real email delivery, disable local mail and configure your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AUTH_REQUIRE_EMAIL_VERIFICATION=false
